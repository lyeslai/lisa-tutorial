class intervals {
    // Cas existants
    loop() {
        def x = 2147483640;
        def step = 10;
        while (x < 2147483647) {
            x = x + step;
        }
        return x;
    }

    basic() {
        def a = 1000000;
        def b = 2000;
        def sum = a + b;
        def prod = a * b;
        def sub = a - b;
        def div = a / b;
    }

    branches(a, b) {
        def result = 0;
        if (a > b) {
            result = a * 10;
        } else {
            result = b - a;
        }
        return result;
    }

    // Tests pour add

    addOverflowPositive() {
        def a = 2147483647; // MAX
        def b = 10;
        def result = a + b;
        return result;
    }

    addOverflowNegative() {
        def a = -2147483646; // MIN
        def b = -10;
        def result = a + b;
        return result;
    }

    // Tests pour sub
    subOverflowPositive() {
        def a = -2147483646; 
        def b = 10;
        def result = a - b;
        return result;
    }

    subOverflowNegative() {
        def a = -10;
        def b = 2147483647; // MAX
        def result = a - b;
        return result;
    }


    mulOverflowPositive() {
        def a = 2147483647; 
        def b = 2;
        def result = a * b;
        return result;
    }

    mulOverflowNegative() {
        def a = -2147483646; 
        def b = 10;
        def result = a * b;
        return result;
    }
    

    divByZero() {
        def a = 1000;
        def b = 0;
        def result = a / b;
        return result;
    }

    divOverflowEdge() {
        def a = -2147483646; 
        def b = -10;
        def result = a / b;
        return result;
    }
}